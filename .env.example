# =============================================================================
# VelocityClear Deployment - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# On MonsterASP.net, set these as application environment variables.
# On Vercel, set these in Project Settings → Environment Variables.
# =============================================================================

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ── SQL Server (MonsterASP.net) ───────────────────────────────────────────────
# Get this from MonsterASP.net control panel → Your Site → Connection Strings
ConnectionStrings__DefaultConnection=Server=your-sql-server.monsterasp.net,1433;Database=your_db_name;User Id=your_user;Password=your_password;TrustServerCertificate=True;

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong key: openssl rand -base64 48
Jwt__SecretKey=REPLACE_WITH_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS
Jwt__Issuer=FinancialPlatform

# ── Event Bus ─────────────────────────────────────────────────────────────────
# Controls which backend the AdaptiveEventBus uses.
# Options: InMemory, Redis, RabbitMQ, Kafka
EventBus__DefaultBackend=InMemory
EventBus__ServiceName=velocityclear-platform

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Dashboard: https://console.upstash.com
# Format: hostname:port,password=<token>,ssl=True
EventBus__RedisUrl=desired-silkworm-41673.upstash.io:6379,password=<YOUR_UPSTASH_TOKEN>,ssl=True

# ── CloudAMQP RabbitMQ ────────────────────────────────────────────────────────
# Dashboard: https://customer.cloudamqp.com
# Format: amqps://user:password@host/vhost
EventBus__RabbitMqUrl=amqps://wjgmnkqh:<YOUR_CLOUDAMQP_PASSWORD>@mouse.rmq5.cloudamqp.com/wjgmnkqh

# ── Aiven Kafka ───────────────────────────────────────────────────────────────
# Dashboard: https://console.aiven.io
# Format: host:port (SSL is configured automatically in KafkaKeepAliveService)
EventBus__KafkaBrokers=chatapp-react-next-kafka-chatapp-react-next.h.aivencloud.com:25204

# ── Grafana Cloud Prometheus ──────────────────────────────────────────────────
# Used by Grafana Cloud Metrics Endpoint integration to scrape /metrics
# Dashboard: https://pyroblazerv2.grafana.net
GRAFANA_CLOUD_REMOTE_WRITE_URL=https://prometheus-prod-52-prod-ap-southeast-2.grafana.net/api/prom/push
GRAFANA_CLOUD_USERNAME=3224592
GRAFANA_CLOUD_API_TOKEN=<GENERATE_FROM_GRAFANA_CLOUD>

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RateLimiting__GeneralMaxRequests=100
RateLimiting__GeneralWindowSeconds=60
RateLimiting__LoginMaxRequests=5
RateLimiting__LoginWindowSeconds=60

# ── Service URLs (consolidated: all point to self) ────────────────────────────
ServiceUrls__TransactionService=http://localhost:5000
ServiceUrls__RiskService=http://localhost:5000
ServiceUrls__PaymentService=http://localhost:5000
ServiceUrls__ComplianceService=http://localhost:5000
ServiceUrls__PinEncryptionService=http://localhost:5000
